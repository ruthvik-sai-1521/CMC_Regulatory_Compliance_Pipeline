{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/schemas/regulatoryFiling.schema.json",
  "title": "CMC Regulatory Filing",
  "type": "object",
  "required": [
    "document_metadata", "drug_substance_profile", "ksm_and_raw_materials",
    "process_controls", "impurity_profile", "nitrosamine_risk_assessment",
    "elemental_impurities", "release_specifications",
    "analytical_method_validation", "stability_data", "commercial_batches",
    "qa_compliance"
  ],
  "properties": {
    "document_metadata": { "$ref": "#/$defs/object" },
    "drug_substance_profile": { "$ref": "#/$defs/object" },
    "ksm_and_raw_materials": { "$ref": "#/$defs/array" },
    "process_controls": { "$ref": "#/$defs/object" },
    "impurity_profile": { "$ref": "#/$defs/object" },
    "nitrosamine_risk_assessment": { "$ref": "#/$defs/object" },
    "elemental_impurities": { "$ref": "#/$defs/array" },
    "release_specifications": { "$ref": "#/$defs/array" },
    "analytical_method_validation": { "$ref": "#/$defs/array" },
    "stability_data": { "$ref": "#/$defs/object" },
    "commercial_batches": {
      "type": "array",
      "items": { "$ref": "#/$defs/object" },
      "minItems": 1
    },
    "qa_compliance": { "$ref": "#/$defs/object" }
  },
  "$defs": {
    "object": { "type": "object" },
    "array": { "type": "array" }
  }
}
