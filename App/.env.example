# Optional overrides -- sensible defaults are baked into backend/app/config.py
# and work out of the box both locally and on Railway.

# PORT is injected automatically by Railway; only needed for local override.
# PORT=8000

# Override where the rule engine loads its GxP rules from (defaults to backend/rules.yaml)
# RULES_YAML_PATH=/srv/backend/rules.yaml

# Override the blank target schema template location (defaults to backend/regulatoryFiling.schema.json)
# SCHEMA_TEMPLATE_PATH=/srv/backend/regulatoryFiling.schema.json

# Scratch directory used for temporary uploaded-PDF processing (ephemeral, auto-created)
# RUNTIME_DIR=/tmp/cmc_pipeline
